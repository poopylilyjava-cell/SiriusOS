# Pinned upstream versions for both toolchains: the bare-metal x86_64-elf one
# (the kernel) and x86_64-sirius (userland, with mlibc).
# Bump deliberately; a toolchain change is an ABI change.
BINUTILS_VERSION=2.47
GCC_VERSION=16.2.0
MLIBC_VERSION=7.0.0
# GCC's configure scripts must be regenerated with exactly this autoconf.
AUTOCONF_VERSION=2.69
# The ports tree's build tool (tools/ports.sh); this commit is version 0.11.0.
# ports/Jinxfile names the matching major version.
JINX_COMMIT=eb1e3d761602bfe601b51e97ce14ba33c3c52d4d
