#! /bin/sh

# pixman: pixel compositing -- what cairo draws with, in software.

version=0.46.4
revision=1
tarball_url="https://cairographics.org/releases/pixman-${version}.tar.gz"
tarball_sha256="d09c44ebc3bd5bee7021c79f922fe8fb2fb57f7320f55e97ff9914d2346a591c"
imagedeps="build-essential meson ninja-build pkg-config"
hostdeps="gcc binutils"
deps="mlibc"

configure() {
    sirius_cross_file cross.txt compilers
    meson setup \
        --cross-file cross.txt \
        --prefix="${prefix}" \
        --libdir=lib \
        -Ddefault_library=static \
        -Dtests=disabled \
        -Ddemos=disabled \
        -Dgtk=disabled \
        -Dlibpng=disabled \
        -Dopenmp=disabled \
        . "${source_dir}"
}

build() {
    ninja -j"${parallelism}"
}

package() {
    DESTDIR="${dest_dir}" ninja install
}
