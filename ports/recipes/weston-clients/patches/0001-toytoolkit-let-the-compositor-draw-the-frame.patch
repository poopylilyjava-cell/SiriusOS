+static void
+decoration_configure(void *data, struct zxdg_toplevel_decoration_v1 *decoration,
+		     uint32_t mode)
+{
+	struct window *window = data;
+	int server_side = mode == ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE;
+
+	if (window->server_side_decorations == server_side)
+		return;
+	window->server_side_decorations = server_side;
+	/* The frame comes or goes: lay the window out again, keeping the
+	 * size of what is inside it. */
+	if (window->main_surface->allocation.width > 0)
+		window_schedule_resize(window,
+				       window->main_surface->allocation.width,
+				       window->main_surface->allocation.height);
+}
+
+static const struct zxdg_toplevel_decoration_v1_listener decoration_listener = {
+	decoration_configure,
+};
