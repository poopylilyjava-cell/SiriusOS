--- /dev/null
+++ b/gcc/config/sirius.h
@@ -0,0 +1,39 @@
+/* Sirius OS: an ELF target with mlibc as its C library.
+
+   Programs are statically linked for now -- the kernel loads ET_EXEC images
+   only -- so the driver always passes -static and there is no dynamic
+   linker to name.  */
+
+#undef  TARGET_SIRIUS
+#define TARGET_SIRIUS 1
+
+#undef  LIB_SPEC
+#define LIB_SPEC "-lc"
+
+/* crt1.o, crti.o and crtn.o come from mlibc's Sirius sysdeps; crtbegin.o and
+   crtend.o from libgcc.  */
+#undef  STARTFILE_SPEC
+#define STARTFILE_SPEC "crt1.o%s crti.o%s crtbegin.o%s"
+
+#undef  ENDFILE_SPEC
+#define ENDFILE_SPEC "crtend.o%s crtn.o%s"
+
+#undef  LINK_SPEC
+#define LINK_SPEC "-static -z max-page-size=4096"
+
+/* As on GNU systems, C++ sees the C library's whole API: libstdc++ needs
+   more of it than ISO C declares, and so do mlibc's own C++ sources.  */
+#undef  CPLUSPLUS_CPP_SPEC
+#define CPLUSPLUS_CPP_SPEC "-D_GNU_SOURCE %(cpp)"
+
+#undef  TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()		\
+  do						\
+    {						\
+      builtin_define ("__sirius__");		\
+      builtin_define ("__unix__");		\
+      builtin_assert ("system=sirius");		\
+      builtin_assert ("system=unix");		\
+      builtin_assert ("system=posix");		\
+    }						\
+  while (false)
